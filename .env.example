# Copy this file to .env.local and fill in your values

# From Resend dashboard → API Keys
RESEND_API_KEY=re_

# From Resend dashboard → Audiences → "Resov Waitlist - Donors" → ID
RESEND_DONOR_AUDIENCE_ID=

# From Resend dashboard → Audiences → "Resov Waitlist - Applicants" → ID
RESEND_APPLICANT_AUDIENCE_ID=

# Must be a verified domain in Resend
FROM_EMAIL=noreply@tryresov.com

# From Vercel dashboard → Integrations → Upstash Redis → your database
# (automatically injected when you add the integration to your Vercel project)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
