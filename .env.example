# Copy this file to .env.local and fill in your values

# From Resend dashboard → API Keys
RESEND_API_KEY=re_

# From Resend dashboard → Audiences → "Resov Waitlist - Donors" → ID
RESEND_DONOR_AUDIENCE_ID=

# From Resend dashboard → Audiences → "Resov Waitlist - Applicants" → ID
RESEND_APPLICANT_AUDIENCE_ID=

# Must be a verified domain in Resend (resov.com is already verified via the backend)
FROM_EMAIL=no-reply@resov.com
